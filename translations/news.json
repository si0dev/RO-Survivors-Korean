  "ed118ba8aca6c7cc9c9b2820dba5821bb7af69b0ee656f71132c70ec61031dfb": {"positions":[null,847],"reason":"history-news","record":{"sourceHash":"3869594448f72896664ea97fbbc77d99112d79d3c443d88e3162013874f7503d","ko":"활 공격: 화살 1발당 피해량이 기존의 두 배를 넘는 수준으로 증가했습니다(13 → 30). ATK의 제곱근에 비례하기 때문에 기존에는 단검이나 검의 절반 수준의 피해를 가했습니다. 궁수, 헌터, 바드/댄서 및 활을 장착한 도둑과 로그에게 동일하게 적용됩니다."}},
  "27615953aed1f0a3645f991646ed7f19680d82b2954773dd2a729a72f9776040": {"positions":[null,848],"reason":"history-news","record":{"sourceHash":"a767a70dda7d05947c774a14fa037927d120dc698a2a01b44ef4a18c16312cb3","ko":"활을 장착한 도둑: 궁수와 마찬가지로 투사체의 기본 관통 확률이 20%가 됩니다."}},
  "4e0b5fc18b908386dd9407fa538b474594f3935208e6e86e0545feaa492e5d6c": {"positions":[null,849],"reason":"history-news","record":{"sourceHash":"701971d67f7284c7861c9991ffd2fe3d88482d7f2b0706e9ad01585ff2ef4441","ko":"개선"}},
